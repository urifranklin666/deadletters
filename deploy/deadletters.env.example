# /etc/deadletters/deadletters.env
#
# Install as root:deadletters with mode 0640:
#   install -o root -g deadletters -m 0640 deadletters.env.example /etc/deadletters/deadletters.env
#
# This file is read by systemd, not automatically by the application. It must
# never be world-readable. Generate secrets locally and never commit real values.
#
# The installer writes <DEADLETTERS_DATA_DIR>/config.json with a saved JWT secret,
# legacy provenance secret, and install metadata. That file is mode 0600 and is
# included in site snapshots. The SQLite database contains the node's Ed25519
# private key and is also included in snapshots. Protect both like credentials.

# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Environment values take precedence over values saved in config.json.
# Uncomment and set these before installation if you want explicit secrets, or
# let the installer generate and persist them in config.json. Rotating
# JWT_SECRET invalidates existing tokens.
# JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_JWT_SECRET
# DEADLETTERS_PROVENANCE_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
DEADLETTERS_TOKEN_TTL=12h

# Required for remote/production web installation. Uncomment, use a long random
# value, and remove it from this file after the site is installed. It is not
# needed for normal login.
# DEADLETTERS_SETUP_TOKEN=REPLACE_WITH_A_ONE_TIME_SETUP_TOKEN

# Leave empty for same-origin only. If cross-origin API clients are required,
# list exact HTTPS origins separated by commas. Never use "*" or a bare domain
# wildcard.
DEADLETTERS_CORS_ORIGINS=

# Structured request logs go to journald. Query strings, cookies, authorization
# headers, and request bodies are never logged.
DEADLETTERS_LOG_REQUESTS=1

# Runtime paths. The engine under /opt/deadletters stays read-only; these paths
# live under the writable state tree. Seed themes/addons (and optionally the
# bundled demo images) into these directories during installation; see
# docs/DEPLOYMENT.md.
DEADLETTERS_DATA_DIR=/var/lib/deadletters/data
DEADLETTERS_UPLOADS_DIR=/var/lib/deadletters/uploads
DEADLETTERS_THEMES_DIR=/var/lib/deadletters/themes
DEADLETTERS_ADDONS_DIR=/var/lib/deadletters/addons
DB_PATH=/var/lib/deadletters/data/deadletters.db

# Backup settings used by scripts/backup.sh and deadletters-backup.service.
# The backup directory should be owner-only (0700). The script applies umask 077.
DEADLETTERS_BACKUP_DIR=/var/lib/deadletters/backups
DEADLETTERS_BACKUP_RETENTION_DAYS=14

# Optional: encrypt each snapshot with age before retention/off-site copy.
# Generate the identity off-host, keep the private identity offline and backed up
# separately, and place only the public recipient here. If age is not installed,
# the backup script fails instead of silently producing plaintext.
# DEADLETTERS_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT

# Optional path overrides for unusual layouts (placeholders shown):
# DEADLETTERS_ENGINE_DIR=/opt/deadletters
# DEADLETTERS_NODE_BIN=/usr/bin/node
